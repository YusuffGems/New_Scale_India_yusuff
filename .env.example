# ── Supabase ────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service role key — server only, never in the browser>

# Project settings → Database → Connection string
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Cloudflare R2 ───────────────────────────────────────────
# R2 → Manage API tokens → Create (Object Read & Write on this bucket)
R2_ACCOUNT_ID=<cloudflare account id>
R2_ACCESS_KEY_ID=<token access key id>
R2_SECRET_ACCESS_KEY=<token secret>
R2_BUCKET=lssc-assessment

# ── Portal ──────────────────────────────────────────────────
PORTAL_ORIGIN=https://assessment.leatherssc.org
